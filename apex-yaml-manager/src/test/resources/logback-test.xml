<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Timestamp for unique log file names -->
    <timestamp key="testRunTimestamp" datePattern="yyyy-MM-dd_HH-mm-ss"/>

    <!-- Console appender for test output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %X{testContext}%msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender for timestamped test audit trail -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/test-logs/apex-yaml-manager-tests_${testRunTimestamp}.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %X{testContext}%msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <!-- Set specific loggers to DEBUG for more detailed output -->
    <logger name="dev.mars.apex.yaml.manager" level="INFO" />
    
    <!-- Reduce noise from Spring and other frameworks -->
    <logger name="org.springframework" level="WARN" />
    <logger name="org.hibernate" level="WARN" />
    <logger name="org.apache" level="WARN" />
</configuration>

