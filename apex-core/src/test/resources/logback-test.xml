<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Timestamp for unique log file names -->
    <timestamp key="testRunTimestamp" datePattern="yyyy-MM-dd_HH-mm-ss"/>

    <!-- Console appender for test output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %X{testContext}%msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender for timestamped test audit trail -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/test-logs/apex-core-tests_${testRunTimestamp}.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %X{testContext}%msg%n</pattern>
        </encoder>
    </appender>

    <!-- Bridge JUL to SLF4J -->
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>

    <!-- Reduce noise from YAML validation during tests -->
    <logger name="dev.mars.apex.core.config.yaml.YamlConfigurationLoader" level="ERROR"/>
    <logger name="dev.mars.apex.core.util.YamlDependencyAnalyzer" level="INFO"/>
    <logger name="dev.mars.apex.core.util.YamlMetadataValidator" level="INFO"/>
    
    <!-- 
        Suppress HikariCP connection pool ERROR logging during tests.
        Intentional error tests trigger expected connection failures which 
        would otherwise dump verbose stack traces to test output.
        Connection errors are properly handled by the application code.
    -->
    <logger name="com.zaxxer.hikari" level="OFF"/>
    
    <!--
        Suppress YamlEnrichmentProcessor ERROR logging during tests.
        Intentional error tests (e.g., SetFieldValueNestedPathTest) trigger expected
        enrichment failures which would otherwise dump verbose stack traces.
        These errors are properly asserted in the test code.
    -->
    <logger name="dev.mars.apex.core.service.enrichment.YamlEnrichmentProcessor" level="OFF"/>

    <!-- Enhanced logging for scenario tests - enable console output -->
    <logger name="dev.mars.apex.core.service.scenario" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Specifically enable ScenarioEndToEndIntegrationTest logging -->
    <logger name="dev.mars.apex.core.service.scenario.ScenarioEndToEndIntegrationTest" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="dev.mars.apex.core.service.scenario.ScenarioStageSpelErrorPropagationTest" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="dev.mars.apex.core.service.scenario.DataTypeScenarioService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="dev.mars.apex.core.service.scenario.ScenarioStageExecutor" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
